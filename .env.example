# Copia questo file in .env.local per lo sviluppo locale.
# Su Vercel le stesse variabili sono in Settings > Environment Variables.

# --- Frontend (finiscono nel bundle pubblico: solo valori pubblici) ---
VITE_SUPABASE_URL=https://<progetto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
VITE_GOOGLE_MAPS_API_KEY=<chiave Google Maps limitata al dominio>
VITE_STRIPE_PUBLISHABLE_KEY=pk_...
VITE_STRIPE_PRICE_ID=price_...
VITE_SUPPORT_EMAIL=support@example.com
VITE_FRONTEND_URL=https://<app>.vercel.app

# --- Solo server (funzioni in /api): MAI con prefisso VITE_ ---
SUPABASE_URL=https://<progetto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
